{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned B public-news repair overlay",
  "type": "object",
  "required": ["schema", "archive_overrides", "base_label_overlays"],
  "properties": {
    "schema": {"const": "sce_B_news_repair_overlay/v1"},
    "archive_overrides": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}$": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "description": "Existing project-relative new NYT response.docs JSON; never overwrite the canonical raw archive"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "meta_path": {"type": "string"},
            "meta_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      },
      "additionalProperties": false
    },
    "base_label_overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "description": "Project-relative JSONL with article_id or label.article_id and the existing basic-topic label schema"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "receipt_files": {"type": "array", "description": "Optional provenance/cost/coverage evidence; never include API keys"}
  }
}
