# SCE derived data and generated study artifacts
data/interim/
data/processed/
data/evaluation/
studies/*/trajectory/*
!studies/*/trajectory/README.md
studies/*/versions/
studies/*/versions.json
studies/*/population/roster.jsonl
studies/*/population/population.json
# SCE study: the 20-person pilot population is a fixed audited input (cloud v3 archive),
# maintained as source here, not a derived artifact.
!studies/sce_inflation_expectations/population/roster.jsonl
!studies/sce_inflation_expectations/population/population.json
studies/*/grounding/data/
studies/*/reports/generated/
proposal/build/
submission/build/
# Generated reviewer bundles live outside outputs; rebuild from tracked sources.
deliverables/research_package/
# Fresh ZIP extraction and local practice results are not submission sources.
/deliverables/本地复现预览/
# Upload copies are local; keep only instructions and fingerprints in Git.
/deliverables/提交材料/*
!/deliverables/提交材料/上传说明.txt
!/deliverables/提交材料/CHECKSUMS.sha256

# Local news review page contains cached full abstracts; curated labels are tracked.
docs/literature/sce/news_selection/news_review_20261011.html
